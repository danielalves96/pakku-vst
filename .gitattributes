# Normalise line endings in the repository, but never in binary files.
#
# Without this a checkout on Windows can rewrite files as if they were text.
# The .pkku presets and the font are binary: converting them to CRLF raises no
# error, it just corrupts them. The installer script needs LF even on Windows,
# and the Inno Setup script expects CRLF.

* text=auto

*.sh   text eol=lf
*.yml  text eol=lf
*.iss  text eol=crlf

*.pkku binary
*.ttf  binary
*.png  binary
*.pkg  binary
